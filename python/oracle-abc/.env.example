# ═══════════════════════════════════════════════════════════════════════════
# oracle-abc —— 本地 .env 配置模板
#
# 用法：复制成同目录下的 .env，然后按注释填
#     cp .env.example .env
#
# ✅ 这个 .env 由脚本自己在启动时读取（python/common/dotenv.py），
#    所以本地 `python index.py` 会生效，在 workflow 里同样会生效。
#    只有「当前没设置或为空」的项会被填上 —— vars / secrets / ref 永远优先。
#
# ⚠️ .env 已加入 .gitignore，**不要提交**：里面装的通常是 OCI 私钥这类真凭据。
#
# ── 优先级（高 → 低）──
#     ref（同名 input）  >  vars / secrets（GitHub Environment）  >  .env
#
# .env 只是**兜底默认值**：某个键一旦被 ref 或 vars/secrets 提供了值，
# 这里对应的行就会被忽略（不会反向覆盖上面两层）。
# 实现见 common/load-dotenv.sh：它只填补当前环境里「未设置或为空」的项。
#
# ── 格式 ──
#     KEY=VALUE              原样
#     KEY="A\nB"             双引号内 \n 还原成换行，首尾引号会被去掉
#     export KEY=VALUE       export 前缀可有可无
#     # 注释、空行会被忽略
#
# ⚠️ 这里必须写**脚本真正读取的变量名**（见 index.py），不是 GitHub Variable 名。
#    workflow 里存在一层映射：vars.OCPU → GRAB_OCPUS，vars.MEMORY → GRAB_MEMORY_GB，
#    vars.TARGET → TARGET_OCPUS。下面已在注释里标出对应关系。
# ═══════════════════════════════════════════════════════════════════════════

# ── OCI 认证（必填）──
OCI_CLI_USER=ocid1.user.oc1..xxxx
OCI_CLI_FINGERPRINT=xx:xx:xx:xx:xx:xx:xx:xx:xx:xx:xx:xx:xx:xx:xx:xx
OCI_CLI_TENANCY=ocid1.tenancy.oc1..xxxx
OCI_CLI_REGION=ap-singapore-1

# 私钥。本地用**文件路径**最方便；CI 里用的是 OCI_CLI_KEY_CONTENT（真凭据，放 secret）。
# 两者二选一，index.py 优先认 OCI_CLI_KEY_CONTENT。
OCI_CLI_KEY_FILE=~/.oci/oci_api_key.pem
# OCI_CLI_KEY_CONTENT="-----BEGIN PRIVATE KEY-----\n...\n-----END PRIVATE KEY-----"

# ── OCI 资源（仅在「创建实例」时需要）──
# 实例一旦存在，脚本只做「停止 → 改规格 → 启动」，下面这几项就不再被读取。
OCI_COMPARTMENT_ID=ocid1.compartment.oc1..xxxx
OCI_AVAILABILITY_DOMAIN=xxxx:AP-SINGAPORE-1-AD-1
OCI_SUBNET_ID=ocid1.subnet.oc1..xxxx
OCI_IMAGE_ID=ocid1.image.oc1..xxxx
OCI_INSTANCE_NAME=oracle-abc

# 公钥内容（~/.ssh/id_ed25519.pub），用于创建时注入免密登录
OCI_SSH_PUBLIC_KEY=

# ── 抢占与升级参数 ──
# 抢占时申请的规格（越小越容易命中容量）。对应 GitHub Variable：OCPU / MEMORY
GRAB_OCPUS=1
GRAB_MEMORY_GB=6

# 升级的最终目标 OCPU 数。对应 GitHub Variable：TARGET
TARGET_OCPUS=2

# 每轮放大倍数：2 = 翻倍（1c→2c→4c），1 = 逐级 +1。对应 GitHub Variable：STEP_FACTOR
STEP_FACTOR=2

# 每个 OCPU 配多少 GB 内存；留空则沿用 GRAB_MEMORY_GB / GRAB_OCPUS 的比例。
# 对应 GitHub Variable：MEMORY_PER_OCPU
MEMORY_PER_OCPU=

# ── 其他（只有脚本读取，GitHub 上没有对应 Variable）──
# OCI_SHAPE=VM.Standard.A1.Flex
# OCI_BOOT_VOLUME_GB=50
# STOP_ACTION=SOFTSTOP
