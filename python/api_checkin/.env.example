# ═══════════════════════════════════════════════════════════════════════════
# api_checkin —— 本地 .env 配置模板
#
# 用法：复制成同目录下的 .env，然后按注释填
#     cp .env.example .env
#
# ⚠️ 本项目的配置项 SITES 里**本身包含凭证**（cookie / 访问令牌）。
#    .env 已被 .gitignore 忽略，本地调试可以用；
#    但**绝对不要提交它**，也不要把它贴给别人排查问题。
#    CI 里请用 Environment secret 配 SITES。
#
# ✅ 由脚本自己在启动时读取（python/common/dotenv.py），
#    所以本地 `python index.py` 会生效，在 workflow 里同样会生效。
#    只有「当前没设置或为空」的项会被填上 —— vars / secrets / ref 永远优先。
#
# 优先级（高 → 低）：ref（inputs.overrides）> vars / secrets > .env
#
# 格式：KEY=VALUE / KEY="VALUE" / export KEY=VALUE
#      双引号内的 \n 会被还原成真换行（多行值靠它）
# ═══════════════════════════════════════════════════════════════════════════

# ── 账号列表（唯一必填项）──
#
# 每行一个账号，4 段，用 | 分隔：
#
#     <站点地址>|<账号标签>|<cookie 或 token[=用户ID]>|<凭证>
#
# 凭证放在**最后一段**，所以凭证里出现 | 也不会被切断。
# 空行与 # 开头的行会被忽略。
#
# 站点有多个 cookie：整段贴上即可，`;` 空格 `=` `|` 都不用转义，例如
#     session=eyJ...; new-api-session=abc123; cf_clearance=xyz.789
#
# 一个站点挂多个账号：多写几行、站点地址重复写即可
# （和 glados_checkin 的「同域名多账号」是同一套约定）。
#
# ⚠️ 两种写法别搞混：
#     .env 里 —— 值本身写成一行，换行用 \n 转义（就是下面这样）
#     CI 的 secret 里 —— 直接回车换行，粘贴成多行就行
#
# 另一种写法是 JSON（站点 → 分桶 → 凭证数组），更适合用 ref 传参：
#     SITES={"https://a.com":{"cookies":["session=xxx"],"tokens":["aNSCxxxxY/8"]},"https://b.com":{"tokens":["sk-zzz"]}}
#   · 以 { 开头就会按 JSON 解析，此时**不要**套外层双引号
#   · 桶名即类型（cookies / tokens），桶内**裸写**凭证即可，不做任何猜测 ——
#     所以令牌不以 sk- 开头也照用，不需要 token: 前缀
#   · 桶内元素要带 user_id / label 时写成对象：
#       {"token":"sk-zzz","user_id":"1001","label":"小号"}
#     user_id 只在**令牌认证**时可能需要（管理接口要求 New-Api-User 头），cookie 用不上；
#     label 纯展示，用于在日志/推送里区分同一站点的多个号
#   · 早期写法（扁平数组、靠自动判断）也还支持：
#       SITES={"https://a.com":["session=xxx","sk-yyy"]}
#     但非 sk- 开头的令牌必须写 token: 前缀，否则会报错或被误判成 cookie
#   · ⚠️ 用 ref（inputs.overrides）传 SITES 等同于把这些凭证公开，详见 README
SITES="https://api.example.com|主号|token=1001|sk-abcdefghijklmnopqrstuvwxyz\nhttps://api.example.com|小号|token|sk-zyxwvutsrqponmlkjihgfedcba\nhttps://another-site.org|dav|cookie|session=eyJhbGciOi...; new-api-session=abc123"

# ── 选填 ──

# PushDeer 推送密钥。留空则跳过推送，只在日志里输出结果
PUSHDEER_SENDKEY=

# 单次请求超时（秒），默认 15
# API_TIMEOUT=15

# 是否输出详细日志（打印接口原始响应，用于排查；凭证不会被打印），默认 false
API_VERBOSE=false
