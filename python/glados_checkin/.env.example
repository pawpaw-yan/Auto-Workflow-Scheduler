# ═══════════════════════════════════════════════════════════════════════════
# glados_checkin —— 本地 .env 配置模板
#
# 用法：复制成同目录下的 .env，然后按注释填
#     cp .env.example .env
#
# ✅ 这个 .env 由脚本自己在启动时读取（python/common/dotenv.py），
#    所以本地 `python index.py` 会生效，在 workflow 里同样会生效。
#    只有「当前没设置或为空」的项会被填上 —— vars / secrets / ref 永远优先。
#
# ⚠️ .env 已加入 .gitignore，**不要提交**：里面装的通常是 cookie 这类真凭据。
#
# ── 优先级（高 → 低）──
#     ref（inputs.overrides）  >  vars / secrets（GitHub Environment）  >  .env
#
# 也就是说 .env 只是**兜底默认值**：某个键一旦被 ref 或 vars/secrets 提供了值，
# 这里对应的行就会被忽略（不会反向覆盖上面两层）。
# 实现见 common/load-dotenv.sh：它只填补当前环境里「未设置或为空」的项。
#
# ── 格式 ──
#     KEY=VALUE              原样
#     KEY="A\nB"             双引号内 \n 还原成换行（多行值就靠它），首尾引号会被去掉
#     KEY='A\nB'             单引号内完全字面，不做任何转义
#     export KEY=VALUE       export 前缀可有可无
#     # 注释、空行会被忽略
#
# 注意：这里必须写**脚本真正读取的变量名**（见 index.py 的 Config 类），
#       不是 GitHub 上那个 Variable 的显示名。
# ═══════════════════════════════════════════════════════════════════════════

# ── 签到域名（必填）──
# 一行一个。行数必须与 COOKIES 一致；同一个域名有多个账号时，重复写域名。
DOMAINS="glados.cloud\nrailgun.info"

# ── 账号 Cookie（必填）──
# 一行一个，与 DOMAINS 按行一一对应。
# 获取：浏览器登录对应域名 → F12 → Application → Cookies → 复制完整串，形如
#     koa:sess=xxx; koa:sess.sig=yyy
COOKIES="koa:sess=AAA; koa:sess.sig=BBB\nkoa:sess=CCC; koa:sess.sig=DDD"

# ── 兑换计划（选填）──
# 留空 = **不执行兑换**。可选 plan100 / plan200 / plan500。
# ⚠️ 多域名时每个「域名 + 账号」任务都会各兑换一次，注意别重复兑换。
GLADOS_EXCHANGE_PLAN=plan500

# ── 是否输出详细日志（选填）──
# true / 1 / yes / y 为开；false / 0 / no / n 为关；不填默认 false。
GLADOS_VERBOSE=true

# ── PushDeer 推送密钥（选填）──
# 留空则跳过推送，只在日志里输出结果。
PUSHDEER_SENDKEY=
